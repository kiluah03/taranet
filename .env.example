# Required by the Next.js server (Supabase Dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Accepts a Supabase publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Exact browser origin, no path. Set HTTPS in production; match Supabase Site URL.
# APP_URL is a server-only override. When both URLs are absent, Vercel deployment
# metadata supplies the production origin (or the preview deployment origin).
# APP_URL=https://taranet.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application submissions only; never used to authenticate users or expose in the browser.
# Accepts a Supabase secret key (sb_secret_...) or legacy service-role key. Store only in .env.local or deployment secrets.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=

# Provider credentials are configured in Supabase Dashboard > Authentication > Providers.
# These are configuration inventory only; Next.js does NOT consume them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# Provider console callback: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# Supabase redirect allow list: http://localhost:3000/auth/callback** and production equivalent.
# NEXTAUTH_URL, NEXTAUTH_SECRET, and app-owned JWT secrets are not used.
